{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run scenes)",
      "Bash(fc-list*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-save-files.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-imports-after-edit.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking imports (black-screen guard)"
          }
        ]
      }
    ]
  }
}
