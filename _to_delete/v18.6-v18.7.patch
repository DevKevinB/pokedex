+      2: { name: 'GABE', caught: [], team: [], mons: {}, badges: [], items: { masterBalls: 1 }, quests: null, settings: { junior: false }, stats: { catches: 0, battlesWon: 0, battlesLost: 0 } } } }));
+    localStorage.setItem('pokedexos_lastplayer', '1');
+  }, junior);
